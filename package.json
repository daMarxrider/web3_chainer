{
  "name": "web3-chainer",
  "version": "0.3.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "chainer": "node apps/cli/src/main.ts",
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\" \"scripts/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:gui": "node --test --test-concurrency=1 \"apps/gui/test/browser/*.test.ts\"",
    "version:check": "node scripts/version.ts check",
    "version:bump": "node scripts/version.ts bump",
    "version:tag": "node scripts/version.ts tag",
    "build:cli": "node scripts/build-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
