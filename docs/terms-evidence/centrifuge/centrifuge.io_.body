.hs-form-field label {
  margin-bottom: 0.5rem;
  color: var(--text-color--text-secondary);
  font-weight: 500;
}

.no-list,
.hs-error-msgs,
.inputs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    color: red;
}

.hs-error-msg,
.hs-main-font-element {
    color: red !important;
        font-size: 12px;

}

.hs-form-private,
.hsForm_1ee71b66-49a0-44a0-b6a2-5495586e101a,
.hs-form-1ee71b66-49a0-44a0-b6a2-5495586e101a,
.hs-form-1ee71b66-49a0-44a0-b6a2-5495586e101a_8c61e410-965c-4589-8141-ce6e0b3a80d4,
.hs-form,
.stacked {
  display: grid;
  grid-auto-columns: 1fr;
  grid-column-gap: 1.5rem;
  grid-row-gap: 1.5rem;
  grid-template-columns: 1fr;
  grid-template-rows: auto auto;
}

.hs-button {
  position: relative;
  z-index: 2;
  padding-top: 0.5rem;
  padding-right: 1.25rem;
  padding-bottom: 0.5rem;
  padding-left: 1.25rem;
  border-top-style: solid;
  border-top-width: 0px;
  border-top-color: black;
  border-right-style: solid;
  border-right-width: 0px;
  border-right-color: black;
  border-bottom-style: solid;
  border-bottom-width: 0px;
  border-bottom-color: black;
  border-left-style: solid;
  border-left-width: 0px;
  border-left-color: black;
  border-top-left-radius: 0.62rem;
  border-top-right-radius: 0.62rem;
  border-bottom-left-radius: 0.62rem;
  border-bottom-right-radius: 0.62rem;
  background-image: linear-gradient(270deg, #ffc012, #ffad60);
  color: var(--text-color--text-primary);
  font-weight: 500;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}
.newsroom-perspective:hover svg path, .newsroom-announcements:hover svg path { fill: #fff !important; }
.newsroom-perspective.investor:hover svg.investor-logo path { fill: var(--link-color--link-primary) !important; }

.hs-form-booleancheckbox-display {
	display: flex;
  float: none !important;
}

.legal-consent-container .hs-input {
  width: 1.125rem;
  height: 1.125rem;
  min-height: 1.125rem;
  margin-top: 2px;
  margin-left: 0px;
  border-radius: 0.25rem;
  background-color: var(--background-color--background-secondary);
}

.legal-consent-container .hs-richtext {
	color: var(--text-color--text-secondary) !important;
  font-size: 0.875rem;
}

.legal-consent-container li {
	padding-left: 0 !important;
}

.legal-consent-container .hs-form-booleancheckbox-display > span {
	margin-left: 12px;
}

.legal-consent-container .hs-input:checked {
  background-image: url(https://cdn.prod.website-files.com/6706324b4c48131ee537ff96/6765a7ded92d58d54c9cafc7_Checkbox.svg);
  background-position: 50% 50%;
  background-size: auto;
}

.hs-input:focus {
    border-color: black; /* Change border color to black on focus */
    outline: none; /* Remove default outline */
}

.submitted-message {
    font-family: 'Inter Tight', sans-serif;
    font-size: 1.25rem;
    color: #1F262F !important;
    background: #F4F5F8;
    padding: 1rem 1.5rem;
    margin-bottom: 0rem;
    text-align: center;
    border-radius: 0.25rem;
    display: flex;
    justify-content: center;
}

.hs-richtext a {
	text-decoration: underline !important;
}

/* Footer HS Form Styling */
.hs-footer-form-js label {
	color: var(--text-color--text-secondary) !important;
}

.hs-footer-form-js .hs-form-private {
	grid-row-gap: 1rem !important;
  color: var(--text-color--text-secondary) !important;
}

.hs-footer-form-js .hs-button {
  position: relative;
  z-index: 2;
  padding-top: 0.5rem;
  padding-right: 1.25rem;
  padding-bottom: 0.5rem;
  padding-left: 1.25rem;
  border-radius: 0.62rem;
  color: var(--text-color--text-primary);
  font-weight: 500;
  text-align: center;
  text-decoration: none;
}

.hs-footer-form-js .hs-button.is-secondary {
  background-color: var(--base-color-neutral--neutral-300);
  transition-property: background-color;
  transition-duration: 300ms;
  transition-timing-function: ease;
  color: var(--base-color-neutral--black);
}

.hs-footer-form-js .hs-button.is-secondary:hover {
  background-color: var(--base-color-neutral--neutral-400);
}
