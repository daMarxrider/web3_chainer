    <style>
        :root {
            --font-primary: Radix, sans-serif;
            --font-secondary: Radix, sans-serif;   
        }

        .loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100svh;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            background: #000;
        }

        .loader__logo {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 15%;
            height: auto;
            opacity: 0;
            animation: rotateInfinite 1.5s infinite ease-in-out;
        }

        @keyframes rotateInfinite {
            0% {
                transform: translate(-50%, -50%) rotate(0deg);
            }
            100% {
                transform: translate(-50%, -50%) rotate(360deg);
            }
        }
    </style>
    
