:154180,"filename":"logo-3840x3840.webp"}},"createdAt":"2024-07-15T21:00:05.462Z","updatedAt":"2024-07-17T18:58:58.176Z","altText":"favicon","url":"https://storage.googleapis.com/polymer-foundation.appspot.com/media/logo.png"}},"menu":[{"isExternal":false,"page":{"relationTo":"pages","value":{"id":"666b1fde3b1536b669ca4e78","metadata":{"title":"Polymer Labs","description":"Polymer Labs is building an L2 interoperability protocol that provides the most secure, neutral, and open framework for deploying cross-chain applications."},"title":"Home","slug":"home","breadcrumbs":[{"doc":"666b1fde3b1536b669ca4e78","url":"/home","label":"Home","id":"6a8f045f28f08d002652b8d0"}],"createdAt":"2024-06-13T16:35:42.622Z","updatedAt":"2026-08-26T15:21:03.514Z","layout":[{"lineOne":"Powering","lineTwo":"Modern","lineThree":"Money","id":"667c82c5297b55194edac432","blockName":"Hero","blockType":"landing"},{"header":{"index":"[ 02 ]","title":"Builder-First","titleTag":"h3","description":"Polymer makes cross-rollup interoperability fast and easy for application builders."},"content":{"title":"Polymer makes interoperability fast and easy for application builders.","description":{"root":{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Make your contracts interoperable. Existing smart contracts work out of the box—no special interfaces required.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"paragraph","version":1}],"direction":"ltr","format":"","indent":0,"type":"root","version":1}},"descriptionPosition":"hidden","links":[]},"style":{"theme":"dark"},"id":"681bb5e5d0758e6662487642","blockType":"textHighlight"},{"header":{"index":"[  03  ]","title":"FEATURES","titleTag":"h3","description":"Polymer is an interop protocol that turns the contracts you already run into cross-chain applications. Your contract emits an event, Polymer proves it happened, and a contract on any other chain acts on it. No bridge interfaces, no per-chain configuration, nothing to redeploy when you add a chain — and it works the same way across 50+ chains."},"content":{"items":[{"title":"Prove API","media":{"id":"66cfa61416518ebeead434bd","videoThumbnail":{"url":"https://storage.googleapis.com/polymer-foundation.appspot.com/media/polymer_06_unify.jpg","width":1000,"height":1000},"prefix":"media","filename":"polymer_06_unify.mp4","mimeType":"video/mp4","filesize":6058360,"sizes":{"thumbnail":{"url":null},"xxs":{"url":null},"xs":{"url":null},"s":{"url":null},"m":{"url":null},"l":{"url":null},"xl":{"url":null},"xxl":{"url":null},"xxxl":{"url":null}},"createdAt":"2024-08-28T22:35:00.141Z","updatedAt":"2024-08-28T22:35:00.141Z","url":"https://storage.googleapis.com/polymer-foundation.appspot.com/media/polymer_06_unify.mp4"},"description":"Own your interop end to end. Customize your cross-chain functionalities without being locked into any standard or interface.","id":"668c6679f96bc035522ea206"},{"title":"Execute API","media":{"id":"66cfa60616518ebeead434b0","videoThumbnail":{"url":"https://storage.googleapis.com/polymer-foundation.appspot.com/media/polymer_05_standardize_r2.jpg","width":1000,"height":1000},"prefix":"media","filename":"polymer_05_standardize_r2.mp4","mimeType":"video/mp4","filesize":2953090,"sizes":{"thumbnail":{"url":null},"xxs":{"url":null},"xs":{"url":null},"s":{"url":null},"m":{"url":null},"l":{"url":null},"xl":{"url":null},"xxl":{"url":null},"xxxl":{"url":null}},"createdAt":"2024-08-28T22:34:46.827Z","updatedAt":"2024-08-28T22:34:46.827Z","url":"https://storage.googleapis.com/polymer-foundation.appspot.com/media/polymer_05_standardize_r2.mp4"},"description":"Execute application logic on any chain in milliseconds. ","id":"668c6677f96bc035522ea205"}]},"style":{"theme":"light"},"id":"668c664ff96bc035522ea204","blockName":"Blueprint","blockType":"mediaListHover"},{"header":{"index":"[ 04 ]","title":"ADVANTAGES"},"content":{"items":[{"media":{"id":"67d19422f5ace2201798c9ca","prefix":"media","filename":"One