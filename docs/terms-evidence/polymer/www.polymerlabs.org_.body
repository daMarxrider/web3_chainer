    <script>




        document.addEventListener('DOMContentLoaded', () => {
            const video = document.querySelector('.loader__video');
            video.play().catch(() => {
                document.querySelector('.loader__logo').style.opacity = 1;
                video.style.display = 'none';
            });
        });

        (function() {
            window._UNSUPPORTED_PAGE_ = 'unsupported.html';

            try {
                eval('let obj = {}; obj?.prop');
            } catch (e) {
                window.location.replace(window._UNSUPPORTED_PAGE_);
                return;
            }

            window._CONFIG_ = {
                ENV: 'production',
                ROOT_URL: 'https://polymerlabs.org'
            };
            window._CACHE_ = '1789570075550';
            window.UIL_STATIC_PATH = 'assets/data/uil.1789570075550.json';
            window.USE_CACHED_FILE = true;
            window.UIL_ID = 'polymer-labs';
            var p = 'app';
            var s = 'assets/js/' + p + '.' + window._CACHE_ + '.js';
            var h = document.head;
            var e = document.createElement('link');
            e.href = s;
            e.rel = 'preload';
            e.as = 'script';
            h.appendChild(e);
            e = document.createElement('script');
            e.src = s;
            e.async = true;
            h.appendChild(e);
        })();
    </script>
